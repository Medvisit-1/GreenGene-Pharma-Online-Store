// GreenGene Pharma — database schema
// Using SQLite for development. Swap `provider` to "postgresql" for production.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  sortOrder   Int       @default(0)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String      @id @default(cuid())
  name             String
  slug             String      @unique
  description      String?
  shortDescription String?
  // Price in cents (ZAR). Avoids float rounding issues.
  price            Int
  compareAtPrice   Int?
  // Admin-determined unit cost (cents) that GreenGene sets. Wholesale prices on
  // quotations are calculated by deducting the volume tier % from this.
  // Recommended Retail Price (cents) is advisory guidance for resellers.
  unitCost         Int?
  rrp              Int?
  sku              String?
  stock            Int         @default(0)
  // JSON-encoded array of image URLs
  images           String      @default("[]")
  brand            String?
  // External marketplace product links (optional)
  takealotUrl      String?
  amazonUrl        String?
  bobshopUrl       String?
  // Show under the "Combos" section
  isCombo          Boolean     @default(false)
  featured         Boolean     @default(false)
  active           Boolean     @default(true)
  category         Category?   @relation(fields: [categoryId], references: [id])
  categoryId       String?
  orderItems       OrderItem[]
  reviews          Review[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
}

model Review {
  id        String   @id @default(cuid())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId String
  author    String
  email     String?
  rating    Int // 1-5
  title     String?
  body      String
  // Status: pending | approved | rejected
  status    String   @default("pending")
  createdAt DateTime @default(now())

  @@index([productId, status])
}

model Setting {
  key   String @id
  value String
}

model Invoice {
  id              String    @id @default(cuid())
  number          String    @unique
  customerName    String
  customerEmail   String
  customerAddress String?
  // unpaid | paid
  status          String    @default("unpaid")
  issueDate       DateTime  @default(now())
  dueDate         DateTime?
  // Human-readable payment terms, e.g. "Net 30 days" or "Due on receipt"
  paymentTerms    String?
  // JSON: [{ description, quantity, unitPrice(cents) }]
  items           String    @default("[]")
  subtotal        Int       @default(0)
  taxRate         Int       @default(0) // percent
  taxAmount       Int       @default(0)
  total           Int       @default(0)
  notes           String?
  // snapshot of business + banking details at creation time (JSON)
  companyDetails  String    @default("{}")
  bankDetails     String    @default("{}")
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
}

model Quotation {
  id              String    @id @default(cuid())
  number          String    @unique
  customerName    String
  customerCompany String?
  customerEmail   String
  customerAddress String?
  // draft | sent | accepted | declined
  status          String    @default("draft")
  issueDate       DateTime  @default(now())
  validUntil      DateTime?
  // JSON: [{ name, quantity, tierPercent, basePrice(cents), unitPrice(cents), rrp(cents|null) }]
  items           String    @default("[]")
  subtotal        Int       @default(0)
  // Bonus offer: buy `bonusBuyQty` units, get `bonusFreeQty` free.
  bonusBuyQty     Int?
  bonusFreeQty    Int?
  // snapshot of the business details + tier table at creation time (JSON)
  companyDetails  String    @default("{}")
  tierTable       String    @default("[]")
  notes           String?
  sentAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
}

model Customer {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String?
  phone           String?
  address         String?
  // Saved delivery address for checkout pre-fill (JSON: line1, line2, suburb, city, province, postalCode)
  shippingDetails String               @default("{}")
  // Only month/day are used (birthday reward). Locked once set.
  birthday        DateTime?
  newsletter      Boolean              @default(false)
  lastLoginAt     DateTime?
  orders          Order[]
  loginTokens     CustomerLoginToken[]
  rewardClaims    RewardClaim[]
  createdAt       DateTime             @default(now())
}

// Single-use, short-lived magic sign-in links. Only a hash of the token is stored.
model CustomerLoginToken {
  id         String    @id @default(cuid())
  tokenHash  String    @unique
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([customerId, createdAt])
}

// A reward customers can earn, configured by the admin.
model Reward {
  id            String        @id @default(cuid())
  title         String
  description   String?
  // milestone | review | birthday | newsletter
  type          String
  // milestone: number of paid orders required
  threshold     Int           @default(0)
  // percent | fixed | freeship
  discountType  String        @default("percent")
  // percent (0-100) or fixed amount in cents; unused for freeship
  discountValue Int           @default(0)
  minSpend      Int           @default(0) // cents
  validDays     Int           @default(90)
  active        Boolean       @default(true)
  sortOrder     Int           @default(0)
  claims        RewardClaim[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// One claimed reward = one single-use promo code locked to the customer's email.
model RewardClaim {
  id         String   @id @default(cuid())
  reward     Reward   @relation(fields: [rewardId], references: [id], onDelete: Cascade)
  rewardId   String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String
  // "" = once ever; birthday = year; review = reviewed product id
  period     String   @default("")
  code       String   @unique
  createdAt  DateTime @default(now())

  @@unique([rewardId, customerId, period])
  @@index([customerId])
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String      @unique
  customer        Customer?   @relation(fields: [customerId], references: [id])
  customerId      String?
  email           String
  phone           String?
  // Fulfilment status: unfulfilled | fulfilled
  status          String      @default("unfulfilled")
  // Payment: unpaid | paid | refunded | failed
  paymentStatus   String      @default("unpaid")
  paymentMethod   String?
  // Stock is only decremented once, when the order is first marked paid
  stockDeducted   Boolean     @default(false)
  paymentRef      String?
  // Amounts in cents (ZAR)
  subtotal        Int
  shipping        Int         @default(0)
  discount        Int         @default(0)
  total           Int
  discountCode    String?
  // JSON-encoded shipping address object
  shippingAddress String      @default("{}")
  notes           String?
  // Bob Go fulfilment
  bobgoOrderId    String?
  trackingNumber  String?
  trackingUrl     String?
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
}

model OrderItem {
  id        String   @id @default(cuid())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   Product? @relation(fields: [productId], references: [id])
  productId String?
  name      String
  image     String?
  price     Int
  quantity  Int
}

model Promotion {
  id            String    @id @default(cuid())
  code          String    @unique
  // Type: percent | fixed | freeship
  type          String    @default("percent")
  value         Int // percent (0-100) or fixed amount in cents
  active        Boolean   @default(true)
  minSpend      Int       @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usageCount    Int       @default(0)
  // manual = created in admin; reward = generated by a customer reward claim
  source        String    @default("manual")
  // When set, the code only works for orders placed with this email
  customerEmail String?
  createdAt     DateTime  @default(now())
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}
